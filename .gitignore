# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Office temporäre Sperrdateien
~$*

# Daten, Exports, Reports (Struktur via .gitkeep behalten)
data/raw/*
data/interim/*
data/processed/*
exports/roboflow/*
reports/figures/*
reports/tables/*
!**/.gitkeep

# Große Dateien: Bilder & Modellgewichte (ggf. Git LFS nutzen)
*.jpg
*.jpeg
*.png
*.h5
*.keras
*.tflite
*.pt
*.pth
*.onnx
*.zip

# Ausnahme: Colab-Experiment-Exporte versionieren
#   Records + Plots normal, Modellgewichte (.pt) via Git LFS (siehe .gitattributes)
!exports/colab/**/*.csv
!exports/colab/**/*.yaml
!exports/colab/**/*.png
!exports/colab/**/*.jpg
!exports/colab/**/*.pt
!exports/weights/**/*.pt
